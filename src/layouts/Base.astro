---
import '../styles/global.css'
import { contactLinks } from '../data/work'

type Props = { title: string; description?: string; image?: string; lang?: string; noindex?: boolean }
const { title, description = 'Dylan Lin works in software and used to work in publishing.', image, lang = 'en', noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = image ? new URL(image, Astro.site) : undefined
const nav = [
	{ href: '/work', label: 'Work' },
	{ href: '/writing', label: 'Writing' },
	{ href: '/about', label: 'About' },
]
const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`)
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="alternate" type="application/rss+xml" title="Dylan Lin" href="/rss.xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
		{socialImage && <meta property="og:image" content={socialImage} />}
		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<div class="site-shell">
			<header class="site-header">
				<a class="site-name" href="/">Dylan Lin</a>
				<nav aria-label="Primary navigation">
					<ul>{nav.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul>
				</nav>
			</header>
			<main id="content"><slot /></main>
			<footer class="site-footer">
				<p>Based in Taipei.</p>
				<nav aria-label="Contact links"><ul>{contactLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></nav>
			</footer>
		</div>
	</body>
</html>
