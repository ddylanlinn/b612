---
import { prototypeBooks } from '../../data/bookshelfPrototype'
---

<section class="prototype-variant" data-variant="B" data-scene="corridor" aria-label="Variant B: Standing bookshelf">
	<div class="scene" data-books={JSON.stringify(prototypeBooks)}></div>
	<div class="corridor-title">
		<p class="variant-kicker">Variant B · Standing shelf</p>
		<h1>Thirty books.<br />One continuous shelf.</h1>
	</div>
	<p class="corridor-index" aria-hidden="true">01&nbsp;&nbsp;&nbsp;15&nbsp;&nbsp;&nbsp;30</p>
</section>
