---
import { prototypeBooks } from '../../data/bookshelfPrototype'
---

<section class="prototype-variant" data-variant="C" data-scene="helix" aria-label="Variant C: Infinite book tower">
	<div class="scene" data-books={JSON.stringify(prototypeBooks)}></div>
	<div class="tower-copy">
		<p class="variant-kicker">Variant C · Infinite tower</p>
		<h1>The library<br />keeps turning.</h1>
		<p>Move left or right around the tower. Move up or down between books.</p>
	</div>
	<div class="tower-axis" aria-hidden="true"></div>
</section>
