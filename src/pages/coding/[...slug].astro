---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'

export const getStaticPaths: GetStaticPaths = async () => (await getCollection('coding')).map((post) => ({ params: { slug: post.id }, props: { post } }))
type Props = { post: CollectionEntry<'coding'> }
const { post } = Astro.props as Props
const { Content } = await render(post)
---
<Base title={`${post.data.title} · Dylan Lin`} description={post.data.summary} lang={post.data.language} noindex={post.data.draft}>
	<article class="article"><header class="article-header"><div class="article-kicker"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time><span>Work</span>{post.data.draft && <span>Draft</span>}</div><h1>{post.data.title}</h1>{post.data.summary && <p class="article-summary">{post.data.summary}</p>}</header><div class="prose-post"><Content /></div></article>
</Base>
