---
import '../styles/bookshelf.css'
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="description" content="Dylan Lin 的個人閱讀收藏。" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<title>Bookshelf · Dylan Lin</title>
	</head>
	<body>
		<a class="skip-link" href="#bookshelf-heading">跳到書櫃</a>
		<header class="bookshelf-header">
			<a href="/">Dylan Lin</a>
			<span>/</span>
			<strong>Bookshelf</strong>
		</header>

		<main>
			<section class="bookshelf-stage" aria-labelledby="bookshelf-heading">
				<div class="scene" aria-hidden="true"></div>
				<div class="bookshelf-title">
					<p>Personal bookshelf</p>
					<h1 id="bookshelf-heading">Books I keep<br />within reach.</h1>
				</div>
				<p class="bookshelf-status" role="status" aria-live="polite">正在載入書櫃…</p>
				<p class="book-position" aria-hidden="true"></p>
			</section>

			<button class="panel-backdrop" type="button" aria-label="關閉書籍詳情" tabindex="-1"></button>
			<aside class="book-panel" aria-live="polite" aria-hidden="true">
				<button class="panel-close" type="button" aria-label="關閉書籍詳情">×</button>
				<p class="panel-label">Selected book</p>
				<h2></h2>
				<p class="panel-author"></p>
				<dl>
					<div><dt>Status</dt><dd class="panel-status"></dd></div>
					<div><dt>ISBN</dt><dd class="panel-isbn"></dd></div>
					<div><dt>Rating</dt><dd class="panel-rating"></dd></div>
					<div><dt>Finished</dt><dd class="panel-finished"></dd></div>
				</dl>
				<div class="panel-sections">
					<span>Overview</span><span>Notes</span><span>Highlights</span><span>Reflections</span><span>Connections</span>
				</div>
				<p class="panel-placeholder">閱讀內容尚未公開。</p>
			</aside>

			<button class="list-toggle" type="button" aria-expanded="false">書單</button>
			<aside class="book-list" aria-hidden="true">
				<div class="book-list-header"><p>Bookshelf</p><button type="button" class="list-close">關閉</button></div>
				<div class="book-list-items"></div>
			</aside>
		</main>

		<script>
			import '../scripts/bookshelf'
		</script>
	</body>
</html>
